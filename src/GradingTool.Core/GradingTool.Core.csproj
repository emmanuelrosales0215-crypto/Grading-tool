<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 is deliberate. Civil 3D 2024 and earlier host .NET Framework 4.8;
      Civil 3D 2025+ hosts .NET 8. netstandard2.0 is referenceable from both, so the
      engine does not have to be rebuilt (or re-targeted) when the Civil 3D version is
      pinned down in Phase 4. This project must never reference an Autodesk assembly.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GradingTool.Core</AssemblyName>
    <RootNamespace>GradingTool</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591 (missing XML doc on a public member) stays a warning, not an error: the
         scaffold documents its ADA constants with plain // comments and forcing an XML doc
         onto every trivial const adds noise without safety. Real warnings still fail. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
